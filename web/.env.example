# Copy to .env.local and fill in from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# New-order emails (optional; ordering works without them). Get a key at resend.com.
RESEND_API_KEY=
# Defaults: to contact@tailored-times.com, from Resend's test sender.
# After verifying tailored-times.com in Resend, set e.g. "Tailored Times <orders@tailored-times.com>".
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=

# Admin demo mode: sample orders/messages behind a pretend login (see below).
# OFF unless set to 1. Leave it empty on anything with real orders: the demo
# login's password is printed on the page.
NEXT_PUBLIC_ADMIN_DEMO=

# Optional. Salt for the hashed addresses in the rate_limits table. Any long
# random string; the secret key is used when this is empty.
RATE_LIMIT_SALT=

# Demo login (only used when NEXT_PUBLIC_ADMIN_DEMO=1). Defaults: admin@gmail.com / Testpassword.
DEMO_ADMIN_USER=
DEMO_ADMIN_PASSWORD=

# Delivery through Wakilni (optional; orders work without it). Sign up at
# https://dev.wakilni.com/sign-up for testing, then Settings -> Api Tokens ->
# "Link to your custom app" gives the key and secret. Orders go to Wakilni when
# they are saved as "delivering" in the admin. Server only.
WAKILNI_KEY=
WAKILNI_SECRET=
# Defaults to the test server. Use https://api.wakilni.com with a live key.
WAKILNI_API_URL=https://api-dev.wakilni.com
# Where the driver picks the papers up (our studio). The area is a Wakilni area name.
WAKILNI_PICKUP_AREA=
WAKILNI_PICKUP_LOCATION_ID=1
WAKILNI_PICKUP_LATITUDE=
WAKILNI_PICKUP_LONGITUDE=
WAKILNI_PICKUP_FLOOR=

# Paying with Whish (whish-partners.pages.dev). The channel and secret come
# from Whish; WHISH_WEBSITE_URL must be the exact site they registered.
# WHISH_API_URL defaults to the sandbox: point it at
# https://api.whish.money/itel-service/api with the live keys.
# NEXT_PUBLIC_WHISH_ENABLED=1 is what puts Whish on the order form.
WHISH_CHANNEL=
WHISH_SECRET=
WHISH_WEBSITE_URL=tailored-times.com
WHISH_API_URL=https://partner.api.sbx.whish.money/itel-service/api
NEXT_PUBLIC_WHISH_ENABLED=

# Where Whish sends people back to and calls us. Must be public: Whish refuses
# localhost, so a local run still points at the live site.
NEXT_PUBLIC_SITE_URL=https://tailored-times.com
